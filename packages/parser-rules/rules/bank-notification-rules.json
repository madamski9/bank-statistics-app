{
  "schemaVersion": 1,
  "version": 5,
  "fragments": {
    "amount": "(?:[0-9]{1,3}(?:\\s[0-9]{3})+|[0-9]+)(?:[,.][0-9]{1,2})?"
  },
  "currencySymbols": {
    "zł": "PLN",
    "zl": "PLN",
    "€": "EUR",
    "$": "USD",
    "£": "GBP",
    "¥": "JPY",
    "₣": "CHF"
  },
  "fallbackCurrency": "PLN",
  "merchantLocationSuffix": {
    "pattern": "\\s+[^,]+,\\s*(?:dolnośląskie|kujawsko-pomorskie|lubelskie|lubuskie|łódzkie|małopolskie|mazowieckie|opolskie|podkarpackie|podlaskie|pomorskie|śląskie|świętokrzyskie|warmińsko-mazurskie|wielkopolskie|zachodniopomorskie)$",
    "caseInsensitive": true
  },
  "fallbackIgnoreReason": "notTransaction",
  "rules": [
    {
      "id": "mbank.outgoingTransfer",
      "whitespace": "single",
      "requires": {
        "subtitle": "empty",
        "title": {
          "pattern": "^przelew z konta$",
          "caseInsensitive": true
        }
      },
      "match": {
        "field": "body",
        "pattern": "^(?<amount>{{amount}})\\s*(?<currency>[A-Z]{3})\\s+do\\s+(?<party>.+?)(?:\\s+\\.)?$",
        "caseInsensitive": true
      },
      "record": {
        "bank": "mbank",
        "sourceApp": "pl.mbank",
        "direction": "expense",
        "transactionType": "outgoingTransfer",
        "amountGroup": "amount",
        "currencyGroups": [
          "currency"
        ],
        "merchant": {
          "group": "party"
        },
        "status": "pending"
      }
    },
    {
      "id": "mbank.incomingTransfer",
      "whitespace": "single",
      "requires": {
        "subtitle": "empty",
        "title": {
          "pattern": "^nowy przelew$",
          "caseInsensitive": true
        }
      },
      "match": {
        "field": "body",
        "pattern": "^(?<amount>{{amount}})\\s*(?<currency>[A-Z]{3})\\s+wpłynęło\\s+od\\s+(?<party>.+?)(?:\\s+\\.)?$",
        "caseInsensitive": true
      },
      "record": {
        "bank": "mbank",
        "sourceApp": "pl.mbank",
        "direction": "income",
        "transactionType": "incomingTransfer",
        "amountGroup": "amount",
        "currencyGroups": [
          "currency"
        ],
        "merchant": {
          "group": "party"
        },
        "status": "pending"
      }
    },
    {
      "id": "wallet.mbankCardPayment",
      "whitespace": "keepDoubleSpace",
      "requires": {
        "subtitle": "present",
        "title": {
          "pattern": "\\bmbank\\b",
          "caseInsensitive": true
        }
      },
      "match": {
        "field": "body",
        "pattern": "^(?:(?<symbolBefore>\\p{Sc})\\s*)?[-−]?\\s*(?<amount>{{amount}})\\s*(?<symbolAfter>zł|zl|\\p{Sc}|[A-Z]{3})?$",
        "caseInsensitive": true
      },
      "record": {
        "bank": "mbank",
        "sourceApp": "pl.mbank",
        "direction": "expense",
        "transactionType": "cardPayment",
        "amountGroup": "amount",
        "currencyGroups": [
          "symbolAfter",
          "symbolBefore"
        ],
        "merchant": {
          "field": "subtitle",
          "stripLocation": true
        },
        "status": "pending"
      }
    },
    {
      "id": "ing.blikPayment",
      "whitespace": "single",
      "requires": { "subtitle": "empty" },
      "match": {
        "field": "body",
        "pattern": "^(?<amount>{{amount}})\\s*(?<currency>[A-Z]{3})\\s+mniej\\s+na\\s+twoim\\s+koncie\\s+-\\s+(?<account>(?:(?!\\s-\\s).)+)\\s+-\\s+płatność\\s+blik\\b.*$",
        "caseInsensitive": true
      },
      "record": {
        "bank": "ing",
        "sourceApp": "pl.ing.mojeing",
        "direction": "expense",
        "transactionType": "blikPayment",
        "amountGroup": "amount",
        "currencyGroups": ["currency"],
        "accountGroup": "account",
        "status": "pending"
      }
    },
    {
      "id": "ing.balanceChange",
      "whitespace": "single",
      "requires": { "subtitle": "empty" },
      "match": {
        "field": "body",
        "pattern": "^(?<amount>{{amount}})\\s*(?<currency>[A-Z]{3})\\s+(?<change>\\p{L}+)\\s+na\\s+twoim\\s+koncie(?:\\s+-\\s+(?<account>(?:(?!\\s-\\s).)+))?(?:\\s+-\\s+.*)?$",
        "caseInsensitive": true
      },
      "record": {
        "bank": "ing",
        "sourceApp": "pl.ing.mojeing",
        "direction": { "group": "change", "cases": { "mniej": "expense" }, "otherwise": "income" },
        "transactionType": {
          "group": "change",
          "cases": { "mniej": "outgoingTransfer" },
          "otherwise": "incomingTransfer"
        },
        "amountGroup": "amount",
        "currencyGroups": ["currency"],
        "accountGroup": "account",
        "status": "pending"
      }
    },
    {
      "id": "pko.transfer",
      "whitespace": "single",
      "requires": { "subtitle": "empty" },
      "match": {
        "field": "body",
        "pattern": "^(?<verb>otrzymano|wysłano|wykonano|zlecono)\\s+przelew\\b.*?\\s*data:\\s*(?<date>[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}(?::[0-9]{2})?)\\s*kwota:\\s*[-−+]?\\s*(?<amount>{{amount}})\\s*(?<currency>[A-Z]{3})\\.?$",
        "caseInsensitive": true
      },
      "record": {
        "bank": "pko",
        "sourceApp": "pl.pkobp.iko",
        "direction": { "group": "verb", "cases": { "otrzymano": "income" }, "otherwise": "expense" },
        "transactionType": {
          "group": "verb",
          "cases": { "otrzymano": "incomingTransfer" },
          "otherwise": "outgoingTransfer"
        },
        "amountGroup": "amount",
        "currencyGroups": ["currency"],
        "occurredAt": {
          "group": "date",
          "formats": ["yyyy-MM-dd HH:mm:ss", "yyyy-MM-dd HH:mm"],
          "timeZone": "Europe/Warsaw"
        },
        "status": "pending"
      }
    },
    {
      "id": "wallet.ersteCardPayment",
      "whitespace": "keepDoubleSpace",
      "requires": {
        "subtitle": "present",
        "title": { "pattern": "\\b(?:erste|santander)\\b", "caseInsensitive": true }
      },
      "match": {
        "field": "body",
        "pattern": "^(?:(?<symbolBefore>\\p{Sc})\\s*)?[-−]?\\s*(?<amount>{{amount}})\\s*(?<symbolAfter>zł|zl|\\p{Sc}|[A-Z]{3})?$",
        "caseInsensitive": true
      },
      "record": {
        "bank": "erste",
        "sourceApp": "pl.bzwbk.mobile.bzwbk24",
        "direction": "expense",
        "transactionType": "cardPayment",
        "amountGroup": "amount",
        "currencyGroups": ["symbolAfter", "symbolBefore"],
        "merchant": { "field": "subtitle", "stripLocation": true },
        "status": "pending"
      }
    },
    {
      "id": "wallet.ingCardPayment",
      "whitespace": "keepDoubleSpace",
      "requires": {
        "subtitle": "present",
        "title": { "pattern": "\\bing\\b", "caseInsensitive": true }
      },
      "match": {
        "field": "body",
        "pattern": "^(?:(?<symbolBefore>\\p{Sc})\\s*)?[-−]?\\s*(?<amount>{{amount}})\\s*(?<symbolAfter>zł|zl|\\p{Sc}|[A-Z]{3})?$",
        "caseInsensitive": true
      },
      "record": {
        "bank": "ing",
        "sourceApp": "pl.ing.mojeing",
        "direction": "expense",
        "transactionType": "cardPayment",
        "amountGroup": "amount",
        "currencyGroups": ["symbolAfter", "symbolBefore"],
        "merchant": { "field": "subtitle", "stripLocation": true },
        "status": "pending"
      }
    },
    {
      "id": "wallet.cardPayment",
      "whitespace": "keepDoubleSpace",
      "requires": { "subtitle": "present" },
      "match": {
        "field": "body",
        "pattern": "^(?:(?<symbolBefore>\\p{Sc})\\s*)?[-−]?\\s*(?<amount>{{amount}})\\s*(?<symbolAfter>zł|zl|\\p{Sc}|[A-Z]{3})?$",
        "caseInsensitive": true
      },
      "record": {
        "bank": {
          "field": "title",
          "pattern": "\\bpko\\b",
          "caseInsensitive": true,
          "whenMatched": "pko",
          "otherwise": "millennium"
        },
        "direction": "expense",
        "transactionType": "cardPayment",
        "amountGroup": "amount",
        "currencyGroups": ["symbolAfter", "symbolBefore"],
        "merchant": { "field": "subtitle", "stripLocation": true },
        "status": "pending"
      }
    },
    {
      "id": "millennium.cardPayment",
      "whitespace": "keepDoubleSpace",
      "match": {
        "field": "body",
        "pattern": "^płatność kartą:?\\s*(?<amount>{{amount}})\\s*(?<currency>[A-Z]{3})\\s+(?:w|u)\\s+(?<merchant>.+?)\\.?$",
        "caseInsensitive": true
      },
      "record": {
        "bank": "millennium",
        "direction": "expense",
        "transactionType": "cardPayment",
        "amountGroup": "amount",
        "currencyGroups": ["currency"],
        "merchant": { "group": "merchant", "stripLocation": true },
        "status": "pending"
      }
    },
    {
      "id": "millennium.cardPaymentWithoutMerchant",
      "whitespace": "keepDoubleSpace",
      "match": { "field": "body", "pattern": "płatność", "caseInsensitive": true },
      "ignore": "cardPaymentAwaitingApplePay"
    },
    {
      "id": "millennium.outgoingTransfer",
      "whitespace": "keepDoubleSpace",
      "match": {
        "field": "body",
        "pattern": "^przelew wychodzący:\\s*kwota:\\s*(?<amount>{{amount}})\\s*(?<currency>[A-Z]{3}),\\s*z rachunku:\\s*(?<account>.+?),\\s*data:\\s*(?<date>[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2})$",
        "caseInsensitive": true
      },
      "record": {
        "bank": "millennium",
        "direction": "expense",
        "transactionType": "outgoingTransfer",
        "amountGroup": "amount",
        "currencyGroups": ["currency"],
        "accountGroup": "account",
        "occurredAt": { "group": "date", "formats": ["dd/MM/yyyy HH:mm"], "timeZone": "Europe/Warsaw" },
        "status": "pending"
      }
    },
    {
      "id": "millennium.incomingTransfer",
      "whitespace": "keepDoubleSpace",
      "match": {
        "field": "body",
        "pattern": "^przelew przychodzący:\\s*kwota:\\s*(?<amount>{{amount}})\\s*(?<currency>[A-Z]{3}),\\s*na rachunek:\\s*(?<account>.+?),\\s*data:\\s*(?<date>[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2})$",
        "caseInsensitive": true
      },
      "record": {
        "bank": "millennium",
        "direction": "income",
        "transactionType": "incomingTransfer",
        "amountGroup": "amount",
        "currencyGroups": ["currency"],
        "accountGroup": "account",
        "occurredAt": { "group": "date", "formats": ["dd/MM/yyyy HH:mm"], "timeZone": "Europe/Warsaw" },
        "status": "pending"
      }
    }
  ]
}
